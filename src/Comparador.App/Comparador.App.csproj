<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>Espejo</AssemblyName>
    <Title>Espejo - Comparador y clonador</Title>
    <Company>VMSofts</Company>
    <Product>Espejo</Product>
    <Authors>VMSofts</Authors>
    <Copyright>VMSofts © 2026</Copyright>
    <Version>2.0.6</Version>
    <!-- Solo las traducciones que se usan: las librerías traen una docena de idiomas que solo engordan el instalador. -->
    <SatelliteResourceLanguages>es;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Comparador.Nucleo\Comparador.Nucleo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <!-- El menú del arrastre con el botón derecho es un componente nativo (C++): se compila junto a Espejo.exe.
       Si el Explorador lo tiene cargado, el archivo está en uso: solo se recompila cuando cambia su código. -->
  <!-- Se compila en obj\nativo y va como un archivo más del proyecto: así llega a bin y también a la carpeta
       publicada que empaqueta el instalador (compilado directo en bin, "dotnet publish" lo dejaba fuera). -->
  <PropertyGroup>
    <MenuArrastreCompilado>$(BaseIntermediateOutputPath)nativo\EspejoExplorador.dll</MenuArrastreCompilado>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MenuArrastreCompilado)" Link="EspejoExplorador.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="CompilarMenuArrastre" BeforeTargets="BeforeBuild"
          Inputs="..\Espejo.Explorador\MenuArrastre.cpp;..\Espejo.Explorador\EspejoExplorador.def;..\Espejo.Explorador\compilar.cmd"
          Outputs="$(MenuArrastreCompilado)">
    <MakeDir Directories="$(BaseIntermediateOutputPath)nativo" />
    <Exec Command="&quot;$(MSBuildProjectDirectory)\..\Espejo.Explorador\compilar.cmd&quot; &quot;$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)nativo\\&quot;" />
  </Target>

</Project>