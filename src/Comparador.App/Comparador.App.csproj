<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>Espejo</AssemblyName>
    <Title>Espejo - Comparador y clonador</Title>
    <Company>VMSofts</Company>
    <Product>Espejo</Product>
    <Authors>VMSofts</Authors>
    <Copyright>VMSofts © 2026</Copyright>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Comparador.Nucleo\Comparador.Nucleo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <!-- El menú del arrastre con el botón derecho es un componente nativo (C++): se compila junto a Espejo.exe.
       Si el Explorador lo tiene cargado, el archivo está en uso: solo se recompila cuando cambia su código. -->
  <Target Name="CompilarMenuArrastre" BeforeTargets="Build"
          Inputs="..\Espejo.Explorador\MenuArrastre.cpp;..\Espejo.Explorador\EspejoExplorador.def;..\Espejo.Explorador\compilar.cmd"
          Outputs="$(OutDir)EspejoExplorador.dll">
    <Exec Command="&quot;$(MSBuildProjectDirectory)\..\Espejo.Explorador\compilar.cmd&quot; &quot;$(MSBuildProjectDirectory)\$(OutDir)&quot;" />
  </Target>

</Project>