<UserControl x:Class="Comparador.App.Vistas.SelectorUbicacion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AllowDrop="True" DragOver="AlArrastrar" Drop="AlSoltar">
    <Border Style="{StaticResource Tarjeta}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:SymbolIcon Grid.RowSpan="2" Symbol="{Binding Icono}" FontSize="24" Margin="4,0,18,0" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="{Binding DescripcionTipo}" Margin="10,1,0,0" Style="{StaticResource TextoSecundario}" />
            </StackPanel>

            <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Ruta, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="C:\Carpeta, \\servidor\carpeta o elige un dispositivo"
                        ClearButtonEnabled="True" />

            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                <ui:Button x:Name="BotonDispositivos" Click="AbrirDispositivos" Margin="0,0,8,0"
                           ToolTip="Memorias USB, unidades de red y teléfonos conectados">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="UsbStick24" Margin="0,0,8,0" />
                        <TextBlock Text="Dispositivos" />
                        <ui:SymbolIcon Symbol="ChevronDown24" Margin="8,0,0,0" FontSize="12" />
                    </StackPanel>
                    <ui:Button.ContextMenu>
                        <ContextMenu x:Name="MenuDispositivos" Placement="Bottom" MinWidth="340" />
                    </ui:Button.ContextMenu>
                </ui:Button>
                <ui:Button Content="Examinar" Command="{Binding ExaminarCommand}" Appearance="Secondary" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
