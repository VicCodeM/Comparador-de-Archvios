<ui:FluentWindow x:Class="Comparador.App.Vistas.VentanaClonado"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding Titulo}"
                 Width="600" SizeToContent="Height" ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 Loaded="AlCargar" Closing="AlCerrar">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="Normal" ProgressValue="{Binding Porcentaje, Converter={StaticResource PorcentajeAFraccion}}" />
    </Window.TaskbarItemInfo>

    <StackPanel>
        <ui:TitleBar Title="{Binding Titulo}" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Margin="20,0,20,18">
            <TextBlock Text="{Binding DeDonde, StringFormat='De: {0}'}" Style="{StaticResource TextoSecundario}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding HaciaDonde, StringFormat='A: {0}'}" Style="{StaticResource TextoSecundario}" TextTrimming="CharacterEllipsis" Margin="0,2,0,12" />

            <StackPanel Visibility="{Binding Terminado, Converter={StaticResource BoolAVisible}, ConverterParameter=!}">
                <Grid>
                    <TextBlock Text="{Binding Fase}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold" Text="{Binding Porcentaje, StringFormat='{}{0:0}%'}" />
                </Grid>
                <ProgressBar Margin="0,10" Height="4" Maximum="100" Value="{Binding Porcentaje, Mode=OneWay}" IsIndeterminate="{Binding Indeterminado}" />
                <Grid>
                    <TextBlock Text="{Binding Detalle}" Style="{StaticResource TextoSecundario}" />
                    <TextBlock HorizontalAlignment="Right" Text="{Binding Velocidad}" Style="{StaticResource TextoSecundario}" />
                </Grid>
                <TextBlock Margin="0,6,0,0" Text="{Binding Restante}" FontWeight="SemiBold" />
            </StackPanel>

            <ui:InfoBar Title="{Binding Resumen}" Severity="{Binding Severidad}" IsOpen="True" IsClosable="False"
                        Visibility="{Binding Terminado, Converter={StaticResource BoolAVisible}}" />

            <Grid Margin="0,14,0,0">
                <TextBlock Text="Creado por Ing. Victor Maldonado - VMSofts" VerticalAlignment="Center" Style="{StaticResource TextoSecundario}" />
                <ui:Button HorizontalAlignment="Right" Content="Cancelar" Command="{Binding CancelarCommand}"
                           Visibility="{Binding Terminado, Converter={StaticResource BoolAVisible}, ConverterParameter=!}" />
                <ui:Button HorizontalAlignment="Right" Content="Cerrar" Appearance="Primary" Click="AlPulsarCerrar"
                           Visibility="{Binding Terminado, Converter={StaticResource BoolAVisible}}" />
            </Grid>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
