<UserControl x:Class="Comparador.App.Vistas.PanelProgreso"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- El avance general y, debajo, cada archivo que se está trabajando ahora con su propia barra -->
    <StackPanel>
        <Border Style="{StaticResource Tarjeta}" Padding="20">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{Binding Fase}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock HorizontalAlignment="Right" FontSize="18" FontWeight="SemiBold"
                               Text="{Binding Porcentaje, StringFormat='{}{0:0}%'}"
                               Visibility="{Binding Indeterminado, Converter={StaticResource BoolAVisible}, ConverterParameter=!}" />
                </Grid>
                <ProgressBar Margin="0,12" Height="4" Maximum="100" Value="{Binding Porcentaje, Mode=OneWay}" IsIndeterminate="{Binding Indeterminado}" />
                <Grid>
                    <TextBlock Text="{Binding Detalle}" />
                    <TextBlock HorizontalAlignment="Right" Text="{Binding Velocidad}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
                <!-- El tiempo restante, a la vista: es lo primero que se busca en una copia larga -->
                <Grid Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Timer24" FontSize="18" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Visibility="{Binding Restante, Converter={StaticResource IgualAVisible}, ConverterParameter=!}" />
                        <TextBlock Text="{Binding Restante}" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Transcurrido}" Style="{StaticResource TextoSecundario}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                            Visibility="{Binding Hilos, Converter={StaticResource IgualAVisible}, ConverterParameter=!}">
                    <ui:SymbolIcon Symbol="Flash24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Hilos}" Style="{StaticResource TextoSecundario}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Ahora mismo" Style="{StaticResource TituloSeccion}"
                   Visibility="{Binding EnCurso.Count, Converter={StaticResource HayAlgoAVisible}}" />
        <Border Style="{StaticResource Tarjeta}" Padding="20,10"
                Visibility="{Binding EnCurso.Count, Converter={StaticResource HayAlgoAVisible}}">
            <!-- Con muchos hilos la lista empujaba los botones de abajo fuera de la pantalla: altura fija y desplazamiento -->
            <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding EnCurso}" ItemTemplate="{StaticResource PlantillaEnCurso}" />
            </ScrollViewer>
        </Border>
    </StackPanel>
</UserControl>
