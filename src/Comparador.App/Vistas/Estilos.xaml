<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:conv="clr-namespace:Comparador.App.Convertidores"
                    xmlns:nucleo="clr-namespace:Comparador.Nucleo.Modelos;assembly=Comparador.Nucleo">

    <conv:IgualAVisibleConverter x:Key="IgualAVisible" />
    <conv:BoolAVisibleConverter x:Key="BoolAVisible" />
    <conv:HayAlgoAVisibleConverter x:Key="HayAlgoAVisible" />
    <conv:TamanoConverter x:Key="Tamano" />
    <conv:FechaConverter x:Key="Fecha" />
    <conv:EstadoTextoConverter x:Key="EstadoTexto" />
    <conv:EstadoIconoConverter x:Key="EstadoIcono" />
    <conv:TemaTextoConverter x:Key="TemaTexto" />
    <conv:TipoIconoConverter x:Key="TipoIcono" />
    <conv:EnumMarcadoConverter x:Key="EnumMarcado" />
    <conv:NoEsConverter x:Key="NoEs" />
    <conv:ReglaTextoConverter x:Key="ReglaTexto" />
    <conv:PorcentajeAFraccionConverter x:Key="PorcentajeAFraccion" />

    <!-- Título de página, como "Inicio" en PowerToys -->
    <Style x:Key="TituloPagina" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <!-- Encabezado de grupo de tarjetas -->
    <Style x:Key="TituloSeccion" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="2,20,0,8" />
    </Style>

    <Style x:Key="TextoSecundario" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Tarjeta: la superficie de PowerToys / Configuración de Windows -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Entrada del menú lateral: fondo suave al pasar, indicador de acento a la izquierda si es la actual -->
    <Style x:Key="BotonMenu" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="4" Padding="12,9" />
                        <Border x:Name="Indicador" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                        <ContentPresenter Margin="12,9" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding EsActual}" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter TargetName="Indicador" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="PlantillaMenu">
        <Button Style="{StaticResource BotonMenu}"
                IsEnabled="{Binding Disponible}"
                Command="{Binding DataContext.NavegarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="{Binding Icono}" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Titulo}" FontSize="14" />
                    <TextBlock Text="{Binding Estado}" Style="{StaticResource TextoSecundario}"
                               Visibility="{Binding Estado, Converter={StaticResource IgualAVisible}, ConverterParameter=!}" />
                </StackPanel>
            </Grid>
        </Button>
    </DataTemplate>

    <!-- Color de cada estado de la comparación, tomado del tema (cambia solo con claro/oscuro) -->
    <Style x:Key="IconoEstado" TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Estado}" Value="{x:Static nucleo:EstadoElemento.Coincide}">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Estado}" Value="{x:Static nucleo:EstadoElemento.Falta}">
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Estado}" Value="{x:Static nucleo:EstadoElemento.Diferente}">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Estado}" Value="{x:Static nucleo:EstadoElemento.SinAcceso}">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Estado}" Value="{x:Static nucleo:EstadoElemento.Error}">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IconoResultado" TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Symbol" Value="CheckmarkCircle24" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Resultado}" Value="{x:Static nucleo:ResultadoArchivo.Fallido}">
                <Setter Property="Symbol" Value="DismissCircle24" />
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Resultado}" Value="{x:Static nucleo:ResultadoArchivo.Saltado}">
                <Setter Property="Symbol" Value="ArrowForward24" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Fila de archivo terminado (copia y errores) -->
    <DataTemplate x:Key="PlantillaTerminado">
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Style="{StaticResource IconoResultado}" Margin="0,0,12,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Nombre}" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource TextoSecundario}">
                    <Run Text="{Binding Mensaje, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Carpeta, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="12,0,0,0" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Tamano}" HorizontalAlignment="Right" Style="{StaticResource TextoSecundario}" />
                <TextBlock Text="{Binding Hora}" HorizontalAlignment="Right" Style="{StaticResource TextoSecundario}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Fila de archivo en curso, con su propia barra -->
    <DataTemplate x:Key="PlantillaEnCurso">
        <Grid Margin="0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <TextBlock Text="{Binding Etapa}" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <ui:Button Content="Saltar" Margin="10,0,0,0" Padding="10,2" FontSize="12" Appearance="Transparent"
                           ToolTip="Deja este archivo como estaba en el destino y sigue con los demás"
                           Command="{Binding DataContext.SaltarArchivoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                           CommandParameter="{Binding}"
                           Visibility="{Binding DataContext.Copiando, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolAVisible}}" />
            </StackPanel>
            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6" Value="{Binding Porcentaje, Mode=OneWay}" Maximum="100" />
            <TextBlock Grid.Row="2" Text="{Binding Carpeta}" Style="{StaticResource TextoSecundario}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Avance}" Margin="12,0,0,0" Style="{StaticResource TextoSecundario}" />
        </Grid>
    </DataTemplate>

    <Style x:Key="FilaTabla" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tabla al estilo Fluent: sin rejilla, filas sobre la tarjeta, selección con relleno suave -->
    <Style x:Key="Tabla" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="48" />
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Padding" Value="10,10" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="10,0">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="RowStyle" Value="{StaticResource FilaTabla}" />
    </Style>

    <!-- Botón de filtro (chip): marcado con el color de acento -->
    <Style x:Key="Chip" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Padding" Value="12,5" />
    </Style>
</ResourceDictionary>
