<ui:FluentWindow x:Class="Comparador.App.Vistas.ExploradorTelefonoVentana"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Elegir carpeta del teléfono"
                 Width="620" Height="560" MinWidth="480" MinHeight="400"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Elegir carpeta del teléfono" ShowMinimize="False" ShowMaximize="False" />

        <Grid Grid.Row="1" Margin="20,8,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Button Command="{Binding SubirCommand}" Appearance="Transparent" ToolTip="Carpeta de arriba" Margin="0,0,8,0">
                <ui:SymbolIcon Symbol="ArrowUp24" />
            </ui:Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Phone24" Margin="0,0,8,0" />
                <TextBlock Text="{Binding RutaVisible}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Margin="20,0" Padding="4">
            <Grid>
                <ListBox x:Name="Lista" ItemsSource="{Binding Subcarpetas}" MouseDoubleClick="AlEntrar" KeyDown="AlPulsarTecla"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Folder24" Margin="0,0,12,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                <TextBlock Text="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40"
                                 Visibility="{Binding Cargando, Converter={StaticResource BoolAVisible}}" />
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="24" VerticalAlignment="Center" TextAlignment="Center"
                           Style="{StaticResource TextoSecundario}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="20,14,20,18">
            <TextBlock Text="Doble clic para entrar en una carpeta" VerticalAlignment="Center" Style="{StaticResource TextoSecundario}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancelar" IsCancel="True" Margin="0,0,8,0" />
                <ui:Button Content="Elegir esta carpeta" Appearance="Primary" Click="AlElegir" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
