<UserControl x:Class="Comparador.App.Vistas.VistaComparacion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vistas="clr-namespace:Comparador.App.Vistas">
    <Grid>
        <!-- Mientras compara -->
        <Grid Visibility="{Binding Comparando, Converter={StaticResource BoolAVisible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,28,40,24" MaxWidth="1000">
                    <TextBlock Text="Comparando" Style="{StaticResource TituloPagina}" />
                    <TextBlock Text="{Binding ParesDeLaComparacion}" Style="{StaticResource TextoSecundario}" Margin="2,-12,0,16" TextWrapping="Wrap" />
                    <vistas:PanelProgreso DataContext="{Binding Progreso}" />
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="40,14">
                <ui:Button HorizontalAlignment="Right" Content="Cancelar" Command="{Binding CancelarCommand}" Icon="{ui:SymbolIcon Stop24}" />
            </Border>
        </Grid>

        <!-- Resultado -->
        <Grid DataContext="{Binding Revision}" Margin="40,28,40,0"
              Visibility="{Binding DataContext.MostrarTabla, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolAVisible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Comparación" Style="{StaticResource TituloPagina}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource TextoSecundario}" Margin="2,0,0,16">
                    <Run Text="{Binding DataContext.ParesDeLaComparacion, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" />
                    <Run Text="   ·   comparado en" /> <Run Text="{Binding Duracion, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <!-- Filtros con su cuenta -->
            <WrapPanel Grid.Row="1">
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding Filtro, Converter={StaticResource EnumMarcado}, ConverterParameter=Pendientes}">
                    <TextBlock><Run Text="Por copiar " /><Run Text="{Binding Pendientes, Mode=OneWay, StringFormat=N0}" FontWeight="SemiBold" /></TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding Filtro, Converter={StaticResource EnumMarcado}, ConverterParameter=Faltan}">
                    <TextBlock><Run Text="Faltan " /><Run Text="{Binding Faltan, Mode=OneWay, StringFormat=N0}" FontWeight="SemiBold" /></TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding Filtro, Converter={StaticResource EnumMarcado}, ConverterParameter=Diferentes}">
                    <TextBlock><Run Text="Distintos " /><Run Text="{Binding Diferentes, Mode=OneWay, StringFormat=N0}" FontWeight="SemiBold" /></TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding Filtro, Converter={StaticResource EnumMarcado}, ConverterParameter=Sobran}">
                    <TextBlock><Run Text="Solo en destino " /><Run Text="{Binding Sobran, Mode=OneWay, StringFormat=N0}" FontWeight="SemiBold" /></TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding Filtro, Converter={StaticResource EnumMarcado}, ConverterParameter=Problemas}">
                    <TextBlock><Run Text="Con problemas " /><Run Text="{Binding Problemas, Mode=OneWay, StringFormat=N0}" FontWeight="SemiBold" /></TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding Filtro, Converter={StaticResource EnumMarcado}, ConverterParameter=Iguales}">
                    <TextBlock><Run Text="Iguales " /><Run Text="{Binding Iguales, Mode=OneWay, StringFormat=N0}" FontWeight="SemiBold" /></TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Chip}" Content="Todos" IsChecked="{Binding Filtro, Converter={StaticResource EnumMarcado}, ConverterParameter=Todos}" />
            </WrapPanel>

            <Grid Grid.Row="2" Margin="0,8,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="420" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Buscar por nombre o carpeta"
                            Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Marcar todo" Command="{Binding SeleccionarVisiblesCommand}" Appearance="Transparent" Icon="{ui:SymbolIcon SelectAllOn24}" />
                    <ui:Button Content="Desmarcar" Command="{Binding QuitarSeleccionVisiblesCommand}" Appearance="Transparent" Icon="{ui:SymbolIcon SelectAllOff24}" Margin="4,0" />
                    <ui:Button Content="Exportar" Command="{Binding ExportarCommand}" Appearance="Transparent" Icon="{ui:SymbolIcon Save24}" />
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="3" ItemsSource="{Binding Visibles}"
                         AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                         SelectionMode="Extended" Style="{StaticResource Tabla}"
                         EnableRowVirtualization="True" EnableColumnVirtualization="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource FilaTabla}">
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Abrir" Icon="{ui:SymbolIcon Open24}"
                                              Command="{Binding AbrirOrigenCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Mostrar en el origen" Icon="{ui:SymbolIcon FolderOpen24}"
                                              Command="{Binding MostrarOrigenCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Mostrar en el destino" Icon="{ui:SymbolIcon FolderOpen24}"
                                              Command="{Binding MostrarDestinoCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Copiar la ruta" Icon="{ui:SymbolIcon Copy24}"
                                              Command="{Binding CopiarRutaCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="¿Qué programa lo tiene abierto?" Icon="{ui:SymbolIcon LockClosed24}"
                                              Command="{Binding QuienLoUsaCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Seleccionado, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SePuedeSincronizar}"
                                          HorizontalAlignment="Center" MinWidth="0" Padding="0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Estado" Width="145" SortMemberPath="Estado">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="{Binding Estado, Converter={StaticResource EstadoIcono}}" Style="{StaticResource IconoEstado}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Estado, Converter={StaticResource EstadoTexto}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Nombre" Width="2*" MinWidth="180" SortMemberPath="RutaRelativa">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nombre}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Carpeta}" Style="{StaticResource TextoSecundario}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Motivo" Width="1.6*" MinWidth="140" Binding="{Binding Motivo}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Tamaño origen" Width="105" Binding="{Binding TamanoOrigen, Converter={StaticResource Tamano}}" SortMemberPath="TamanoOrigen" IsReadOnly="True" />
                    <DataGridTextColumn Header="Tamaño destino" Width="110" Binding="{Binding TamanoDestino, Converter={StaticResource Tamano}}" SortMemberPath="TamanoDestino" IsReadOnly="True" />
                    <DataGridTextColumn Header="Fecha origen" Width="135" Binding="{Binding FechaOrigen, Converter={StaticResource Fecha}}" SortMemberPath="FechaOrigen" IsReadOnly="True" />
                    <DataGridTextColumn Header="Fecha destino" Width="135" Binding="{Binding FechaDestino, Converter={StaticResource Fecha}}" SortMemberPath="FechaDestino" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Barra de acción -->
            <Grid Grid.Row="4" Margin="-40,10,-40,0">
                <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="40,14">
                    <Grid>
                        <TextBlock Text="{Binding ResumenSeleccion}" VerticalAlignment="Center" />
                        <ui:Button HorizontalAlignment="Right" Appearance="Primary" Padding="22,8" Content="Copiar seleccionados"
                                   Icon="{ui:SymbolIcon DocumentCopy24}"
                                   Command="{Binding DataContext.IniciarCopiaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
