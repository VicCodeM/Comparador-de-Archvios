<ui:FluentWindow x:Class="Comparador.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:mv="clr-namespace:Comparador.App.ModelosVista"
                 xmlns:vistas="clr-namespace:Comparador.App.Vistas"
                 Title="Comparador de Archivos"
                 Width="1280" Height="820" MinWidth="980" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Window.DataContext>
        <mv:PrincipalModeloVista />
    </Window.DataContext>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding EstadoBarraTareas}" ProgressValue="{Binding AvanceBarraTareas}" />
    </Window.TaskbarItemInfo>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Comparador de Archivos">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <!-- El menú se ensancha o se angosta arrastrando su borde, y se pliega a solo iconos con el botón -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColumnaMenu" Width="280" MinWidth="60" MaxWidth="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Menú lateral: los pasos se pueden pulsar en cuanto hay algo que ver en ellos -->
            <DockPanel Margin="8,4,8,12" ClipToBounds="True" SizeChanged="AlCambiarAnchoMenu">
                <ui:Button DockPanel.Dock="Top" Appearance="Transparent" Margin="2,0,0,6" Padding="10,8"
                           Click="PlegarMenu" ToolTip="Plegar o desplegar el menú">
                    <ui:SymbolIcon Symbol="LineHorizontal320" FontSize="18" />
                </ui:Button>
                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Margin="4,8" />
                    <ContentControl Content="{Binding MenuInferior}" ContentTemplate="{StaticResource PlantillaMenu}" />
                    <TextBlock x:Name="Credito" Text="Creado por Ing. Victor Maldonado - VMSofts" Margin="12,12,12,0"
                               Style="{StaticResource TextoSecundario}" TextWrapping="Wrap" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Menu}" ItemTemplate="{StaticResource PlantillaMenu}" Focusable="False" />
            </DockPanel>

            <GridSplitter Grid.Column="0" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE" ResizeBehavior="CurrentAndNext" />

            <!-- Área de contenido, con la esquina redondeada y la capa de PowerToys -->
            <Border Grid.Column="1"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0">
                <Grid>
                    <vistas:VistaUbicaciones Visibility="{Binding PaginaActual, Converter={StaticResource IgualAVisible}, ConverterParameter=Ubicaciones}" />
                    <vistas:VistaComparacion Visibility="{Binding PaginaActual, Converter={StaticResource IgualAVisible}, ConverterParameter=Comparacion}" />
                    <vistas:VistaCopia Visibility="{Binding PaginaActual, Converter={StaticResource IgualAVisible}, ConverterParameter=Copia}" />
                    <vistas:VistaConfiguracion Visibility="{Binding PaginaActual, Converter={StaticResource IgualAVisible}, ConverterParameter=Configuracion}" />

                    <ui:InfoBar DataContext="{Binding Avisos}"
                                VerticalAlignment="Bottom" Margin="32,0,32,20" MaxWidth="900"
                                Title="{Binding Mensaje}"
                                Severity="{Binding Severidad}"
                                IsOpen="{Binding Visible, Mode=TwoWay}"
                                IsClosable="True">
                        <ui:Button Content="{Binding TextoAccion}" Command="{Binding EjecutarCommand}"
                                   Visibility="{Binding TieneAccion, Converter={StaticResource BoolAVisible}}" />
                    </ui:InfoBar>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
